<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Fault Time Management System</title>
<style>
* { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; }
body { background: #f4f6f9; padding: 20px; color: #333; }
.container { max-width: 1200px; margin: 0 auto; }
h1 { margin-bottom: 20px; color: #1a252f; }

.metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-bottom: 25px; }
.card { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); text-align: center; }
.card h3 { color: #7f8c8d; font-size: 14px; text-transform: uppercase; margin-bottom: 10px; }
.card .value { font-size: 32px; font-weight: bold; color: #2c3e50; }

.main-layout { display: grid; grid-template-columns: 320px 1fr; gap: 20px; }

.form-section { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); height: fit-content; }
.form-group { margin-bottom: 15px; }
label { display: block; font-weight: 600; margin-bottom: 5px; font-size: 14px; }
input, select, textarea { width: 100%; padding: 10px; border: 1px solid #ccc; border-radius: 5px; font-size: 14px; }
button { width: 100%; background: #27ae60; color: white; border: none; padding: 12px; font-size: 16px; border-radius: 5px; cursor: pointer; font-weight: bold; }
button:hover { background: #219150; }

.table-section { background: #fff; padding: 20px; border-radius: 8px; box-shadow: 0 2px 5px rgba(0,0,0,0.05); overflow-x: auto; }
table { width: 100%; border-collapse: collapse; text-align: left; }
th, td { padding: 12px; border-bottom: 1px solid #eee; font-size: 14px; }
th { background: #fafafa; color: #555; }

.badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; text-transform: uppercase; }
.badge-critical { background: #e74c3c; color: white; }
.badge-high { background: #e67e22; color: white; }
.badge-medium { background: #f1c40f; color: #333; }
.badge-low { background: #3498db; color: white; }

.status-btn { padding: 6px 12px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 12px; }
.btn-progress { background: #f39c12; color: white; }
.btn-resolved { background: #2ecc71; color: white; }
.timer { font-weight: bold; color: #c0392b; font-family: monospace; }

@media(max-width: 768px) {
.main-layout { grid-template-columns: 1fr; }
}
</style>
</head>
<body>

<div class="container">
<h1>Fault Time Management Dashboard</h1>

<!-- Analytics Cards -->
<div class="metrics-grid">
<div class="card">
<h3>Total Faults</h3>
<div class="value" id="metric-total">0</div>
</div>
<div class="card">
<h3>Active Faults</h3>
<div class="value" id="metric-active">0</div>
</div>
<div class="card">
<h3>Avg Resolution Time (MTTR)</h3>
<div class="value" id="metric-mttr">0 min</div>
</div>
</div>

<div class="main-layout">
<!-- Log Fault Form -->
<div class="form-section">
<h2 style="margin-bottom: 15px; font-size: 18px;">Log New Fault</h2>
<form id="fault-form">
<div class="form-group">
<label>Fault Name / Issue</label>
<input type="text" id="title" placeholder="e.g., Network Switch Unreachable" required>
</div>
<div class="form-group">
<label>Asset / Location</label>
<input type="text" id="asset" placeholder="e.g., Rack 4 / Server Room" required>
</div>
<div class="form-group">
<label>Severity</label>
<select id="severity">
<option value="Low">Low</option>
<option value="Medium" selected>Medium</option>
<option value="High">High</option>
<option value="Critical">Critical</option>
</select>
</div>
<button type="submit">Log Fault & Start Clock</button>
</form>
</div>

<!-- Faults List Table -->
<div class="table-section">
<h2 style="margin-bottom: 15px; font-size: 18px;">Active & Recent Faults</h2>
<table>
<thead>
<tr>
<th>Asset</th>
<th>Fault Name</th>
<th>Severity</th>
<th>Downtime Duration</th>
<th>Status</th>
<th>Action</th>
</tr>
</thead>
<tbody id="faults-table-body">
<!-- Dynamic Data Inserted Here -->
</tbody>
</table>
</div>
</div>
</div>

<script>
// Initialize data from LocalStorage or empty array
let faultsData = JSON.parse(localStorage.getItem('faultsData')) || [];

function saveAndReload() {
localStorage.setItem('faultsData', JSON.stringify(faultsData));
loadFaults();
}

// Load metrics and faults
function loadFaults() {
const totalFaults = faultsData.length;
const activeFaults = faultsData.filter(r => r.status !== 'Resolved').length;

// Calculate MTTR
const resolved = faultsData.filter(r => r.status === 'Resolved' && r.resolved_at);
let totalResolutionTimeMinutes = 0;
resolved.forEach(f => {
const start = new Date(f.reported_at);
const end = new Date(f.resolved_at);
totalResolutionTimeMinutes += (end - start) / (1000 * 60);
});
const avgResolutionTime = resolved.length ? (totalResolutionTimeMinutes / resolved.length).toFixed(1) : 0;

document.getElementById('metric-total').innerText = totalFaults;
document.getElementById('metric-active').innerText = activeFaults;
document.getElementById('metric-mttr').innerText = ${avgResolutionTime} min`;

renderTable();
}

// Submit new fault
document.getElementById('fault-form').addEventListener('submit', (e) => {
e.preventDefault();
const title = document.getElementById('title').value;
const asset = document.getElementById('asset').value;
const severity = document.getElementById('severity').value;

const newFault = {
id: Date.now(),
title,
asset,
severity,
status: 'Open',
reported_at: new Date().toISOString(),
resolved_at: null,
root_cause: ''
};

faultsData.unshift(newFault);
document.getElementById('fault-form').reset();
saveAndReload();
});

// Update Status
function updateStatus(id, newStatus) {
const fault = faultsData.find(f => f.id === id);
if (!fault) return;

fault.status = newStatus;
if (newStatus === 'Resolved') {
fault.resolved_at = new Date().toISOString();
fault.root_cause = prompt("Enter Root Cause / Action Taken:") || "Resolved";
}

saveAndReload();
}

// Render Table
function renderTable() {
const tbody = document.getElementById('faults-table-body');
tbody.innerHTML = '';

if (faultsData.length === 0) {
tbody.innerHTML = <tr&gt;&lt;td colspan="6" style="text-align:center; color:#7f8c8d;"&gt;No faults logged yet.&lt;/td&gt;&lt;/tr>;
return;
}

faultsData.forEach(fault => {
const tr = document.createElement('tr');
const badgeClass = badge badge-${fault.severity.toLowerCase()}`;

tr.innerHTML = &lt;td&gt;&lt;strong&gt;${fault.asset}</strong></td>
<td>${fault.title}&lt;/td&gt; &lt;td&gt;&lt;span class="${badgeClass}">${fault.severity}&lt;/span&gt;&lt;/td&gt; &lt;td&gt;&lt;span class="timer" id="timer-${fault.id}">-</span></td>
<td><strong>${fault.status}&lt;/strong&gt;&lt;/td&gt; &lt;td&gt; ${fault.status === 'Open' ? <button class="status-btn btn-progress" onclick="updateStatus(${fault.id}, 'In Progress')">Start Progress</button>: ''} ${fault.status === 'In Progress' ? <button class="status-btn btn-resolved" onclick="updateStatus(${fault.id}, 'Resolved')">Mark Resolved</button>: ''} ${fault.status === 'Resolved' ? <span style="color:#27ae60; font-weight:bold;"&gt;Closed&lt;/span> : ''}
</td>
`;
tbody.appendChild(tr);
});

updateTimers();
}

// Live Downtime Counter Logic
function updateTimers() {
faultsData.forEach(fault => {
const timerElem = document.getElementById(timer-${fault.id}`);
if (!timerElem) return;

const startTime = new Date(fault.reported_at);
const endTime = fault.resolved_at ? new Date(fault.resolved_at) : new Date();

const diffMs = Math.max(0, endTime - startTime);
const mins = Math.floor(diffMs / 60000);
const secs = Math.floor((diffMs % 60000) / 1000);
const hrs = Math.floor(mins / 60);

const formatted = ${hrs.toString().padStart(2, '0')}:${(mins % 60).toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')};
timerElem.innerText = formatted;
});
}

// Run clock updates every second
setInterval(updateTimers, 1000);

// Initial Load
loadFaults();
</script>

</body>
</html>
